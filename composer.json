{
    "name": "purpledot/miconvener",
    "type": "project",
    "description": "MiConvener — multi-tenant event management platform.",
    "keywords": ["laravel", "events", "event-management"],
    "license": "MIT",
    "require": {
        "php": "^8.4.0",
        "ext-pdo_pgsql": "*",
        "aws/aws-sdk-php": ">=3.394.8",
        "bacon/bacon-qr-code": "^3.1.1",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "doctrine/dbal": "^4.4.4",
        "google/apiclient": "^2.19.4",
        "guzzlehttp/guzzle": "^7.15.5",
        "inertiajs/inertia-laravel": "^3.3.2",
        "jenssegers/agent": "^2.6.4",
        "laravel/framework": "^13.30.1",
        "laravel/reverb": "^1.11.1",
        "laravel/sanctum": "^4.3.3",
        "laravel/tinker": "^3.0.2",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "livewire/livewire": "^4.4.3",
        "maatwebsite/excel": "^4.0.2",
        "nunomaduro/essentials": "^1.2",
        "opcodesio/log-viewer": "^3.24.2",
        "pragmarx/google2fa-laravel": "^3.0.1",
        "propaganistas/laravel-phone": "^6.0.3",
        "psr/simple-cache": "^3.0",
        "spatie/cpu-load-health-check": "^1.0.5",
        "spatie/laravel-activitylog": "^4.12.3",
        "spatie/laravel-backup": "^10.3.2",
        "spatie/laravel-health": "^1.40.2",
        "spatie/laravel-permission": "^6.25",
        "spatie/security-advisories-health-check": "^1.3.2",
        "stevebauman/location": "^7.6.3",
        "stripe/stripe-php": ">=19.2",
        "tightenco/ziggy": "^2.6.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4.3",
        "driftingly/rector-laravel": "^2.6.2",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.11.0",
        "laravel/boost": "^2.7.0",
        "laravel/breeze": "^2.4.2",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.30.5",
        "laravel/sail": "^1.67.0",
        "laravel/telescope": "^5.23",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.1.3",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "rector/rector": "^2.6.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "composer install",
            "@php artisan key:generate",
            "@php artisan app:setup-database",
            "@php artisan migrate --force",
            "npm install --legacy-peer-deps",
            "npm run build"
        ],
        "setup:starterkit": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "composer install",
            "@php artisan key:generate",
            "@php artisan app:setup-database",
            "@php artisan migrate:fresh --seed --force",
            "npm install --legacy-peer-deps",
            "npm run build"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear",
            "@update:requirements"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "update:requirements": [
            "composer bump",
            "npx npm-check-updates -u"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "npm run lint"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "npm run test:lint"
        ],
        "test:unit": "pest --parallel --coverage --exactly=100.0",
        "test:types": "phpstan",
        "test": [
            "@test:type-coverage",
            "@test:unit",
            "@test:lint",
            "@test:types"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
