{
  "permissions": {
    "allow": [
      "mcp__laravel-boost__application-info",
      "mcp__laravel-boost__database-schema",
      "Bash(wc:*)",
      "mcp__laravel-boost__search-docs",
      "Bash(php artisan test:*)",
      "Bash(php -v:*)",
      "Bash(\"$HOME/Library/Application Support/Herd/bin/php\" vendor/bin/pint --dirty)",
      "mcp__laravel-boost__get-config",
      "Bash(\"$HOME/Library/Application Support/Herd/bin/php\" artisan test:*)",
      "Bash(\"$HOME/Library/Application Support/Herd/bin/php\" artisan test --compact)",
      "Bash(\"$HOME/Library/Application Support/Herd/bin/php\" -d memory_limit=-1 artisan test --compact)",
      "Bash(\"$HOME/Library/Application Support/Herd/bin/php\" -i)",
      "Bash(\"$HOME/Library/Application Support/Herd/bin/php\" -r 'echo ini_get\\(\"\"memory_limit\"\"\\);')",
      "Bash(\"$HOME/Library/Application Support/Herd/bin/php\":*)",
      "Bash(\"$HOME/Library/Application Support/Herd/bin/php\" -d memory_limit=512M vendor/bin/pest --compact --filter=\"MeetingRoom\")",
      "Bash(vendor/bin/pint:*)",
      "mcp__laravel-boost__get-absolute-url",
      "mcp__laravel-boost__list-routes",
      "mcp__laravel-boost__database-query",
      "mcp__laravel-boost__last-error",
      "mcp__laravel-boost__tinker"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "laravel-boost"
  ]
}
