APP_NAME=Miconvener
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://miconvener.test
APP_SIDEBAR_SKIN=light

SECRETS_PROVIDER=local

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Landlord Database (Global Control Plane)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=miconvener
DB_USERNAME=root
DB_PASSWORD=root

# Note: Tenant databases are managed dynamically by the system.
# The 'tenant' connection in config/database.php uses these drivers:
TENANT_DB_DRIVER=sqlite
TENANT_DB_DATABASE=storage/tenants/default.sqlite

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=miconvener.test

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Meeting Audio Storage (use 'meeting-audio-local' for local dev, 'meeting-audio' for S3)
MEETING_AUDIO_BUCKET=xdata-meeting-audio
MEETING_AUDIO_DISK=meeting-audio-local
MEETING_PRESIGNED_URL_TTL=900
MEETING_MAX_CHUNK_SIZE_MB=10

# Meeting Transcription (use 'fake' for local dev, 'aws' for production)
MEETING_TRANSCRIPTION_DRIVER=fake
MEETING_TRANSCRIPTION_OUTPUT_BUCKET=xdata-meeting-transcripts
MEETING_DEFAULT_LANGUAGE=en-US
MEETING_MAX_SPEAKERS=10

# Meeting AI Processing (use 'fake' for local dev, 'bedrock' for production)
MEETING_AI_DRIVER=fake

# Calendar Integrations
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_REDIRECT_URI=
OUTLOOK_CALENDAR_TENANT=common
CALENDAR_SYNC_ENABLED=true

# Project Management Integrations
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
MONDAY_REDIRECT_URI=
PM_SYNC_ENABLED=true
PM_QUEUE=pm-sync

# Team Communication (Slack & Teams)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_SIGNING_SECRET=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_REDIRECT_URI=
TEAMS_TENANT_ID=
CHAT_QUEUE=chat-notifications

# Meeting Queue
MEETING_QUEUE_CONNECTION=database
MEETING_BROADCASTING_ENABLED=false

# Laravel Reverb (WebSocket - install with: composer require laravel/reverb)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ALLOW_REGISTRATION=false
ENABLE_SOCIAL_LOGIN=false
SOFTWARE_PROVIDER=Purpledot
SOFTWARE_PROVIDER_URL=https://wearepurpledot.com
SUPERADMIN_EMAIL=hiselase@gmail.com

# Payment Gateways — platform-level (SaaS subscription billing) credentials only.
# Per-tenant event-ticket payment credentials are configured per organizer via
# Settings > Payments and stored encrypted in the tenant_payment_gateways table —
# they are never read from environment variables.
PAYMENT_DRIVER=paystack
PAYMENT_DEV_BYPASS=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_MERCHANT_EMAIL=
PAYSTACK_CURRENCY=GHS
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Paystack settlement credentials (for paying out to organizers) — these are platform-level credentials only.
SETTLEMENT_DRIVER=paystack
SETTLEMENT_PAYSTACK_SECRET_KEY=
SETTLEMENT_PAYSTACK_PUBLIC_KEY=
SETTLEMENT_PAYSTACK_WEBHOOK_SECRET=


THEME_PRIMARY_COLOR="#168f7f"
THEME_PRIMARY_COLOR_DARK="#1d6057"

# Inertia SSR is off until a Node SSR server is actually set up and running.
INERTIA_SSR_ENABLED=false

IGNITION_EDITOR="vscode"
